# Copy this file to .env and fill in real values. Never commit the real .env file.

# Used to sign Flask session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: automatically create the first admin account on startup.
# Leave blank to skip and promote an admin manually later.
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: max upload size in megabytes (default 50)
MAX_UPLOAD_MB=50

# Optional: comma-separated list of exact origins allowed to call the API
# with credentials (cookies) from a browser. Leave blank for local
# development — any http://localhost:<port> / http://127.0.0.1:<port>
# origin (e.g. VS Code Live Server) is allowed automatically. Set this for
# a real deployment, e.g.:
#   CORS_ORIGINS=https://your-frontend.example.com
CORS_ORIGINS=

# Optional: enables the AI Usage Assistant to answer with a real external AI
# model instead of its built-in FAQ matcher. Requires the `anthropic` package
# (uncomment it in requirements.txt). Leave blank to skip - the assistant,
# security analysis, privacy suggestions and analytics insights all still
# work fully without this, using built-in heuristics/rules on real app data.
AI_API_KEY=
